@model Obilet.JourneySearch.Web.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Otobüs Bileti Ara";
    var locations = Model.Locations;
}

<div class="container mt-5">
    <h1 class="mb-4">Otobüs Bileti Ara</h1>

<form asp-controller="Home"asp-action="Search"method="post">@Html.AntiForgeryToken()
        <div class="row g-3 align-items-end">

<div class="col-md-5">
    <label for="originSearch" class="form-label">Nereden</label>

    <div class="position-relative">
        <input type="text"
               id="originSearch"
               class="form-control"
               placeholder="Kalkış noktası ara..."
               autocomplete="off"
               value="@locations.FirstOrDefault(x => x.Id == Model.OriginId)?.Name" />

        <input type="hidden"
               id="originId"
               name="OriginId"
               value="@Model.OriginId" />

        <div id="originSuggestions"
             class="list-group position-absolute w-100 shadow-sm"
             style="z-index: 1000; display: none;">
        </div>
    </div>
</div>


            <div class="col-md-2">
                <button type="button"
                        id="swapLocations"
                        class="btn btn-outline-secondary w-100">
                    ⇄ Değiştir
                </button>
            </div>


<div class="col-md-5">
    <label for="destinationSearch" class="form-label">Nereye</label>

    <div class="position-relative">
        <input type="text"
               id="destinationSearch"
               class="form-control"
               placeholder="Varış noktası ara..."
               autocomplete="off"
               value="@locations.FirstOrDefault(x => x.Id == Model.DestinationId)?.Name" />

        <input type="hidden"
               id="destinationId"
               name="DestinationId"
               value="@Model.DestinationId" />

        <div id="destinationSuggestions"
             class="list-group position-absolute w-100 shadow-sm"
             style="z-index: 1000; display: none;">
        </div>
    </div>
</div>


            <div class="col-md-4">
                <label for="departureDate" class="form-label">Gidiş tarihi</label>
                <input type="date"
                       id="departureDate"
                       name="departureDate"
                       class="form-control"
                       value="@Model.DepartureDate.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

<div asp-validation-summary="All"
     class="text-danger mt-3"
     role="alert">
</div>



            <div id="validationMessage"class="alert alert-danger mt-3 d-none"role="alert"></div>

            <div class="col-md-4">
                <button type="button" id="todayButton"
                        class="btn btn-outline-secondary me-2">
                    Bugün
                </button>
                <button type="button" id="tomorrowButton"
                        class="btn btn-outline-secondary">
                    Yarın
                </button>
            </div>

            <button type="submit" class="btn btn-primary mt-3">
    Sefer Ara
</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
